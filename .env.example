# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local` — it is ignored by git.

# --- Sanity project (public: safe to expose to the browser) ---------------
# Find the project ID at https://www.sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# A date. Queries behave as the Sanity API did on this day. No need to change it.
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# --- Secrets (server only: never prefix these with NEXT_PUBLIC_) ----------
# Optional for a public dataset. A token with "Viewer" permissions:
# sanity.io/manage → API → Tokens → Add API token.
SANITY_API_READ_TOKEN=
# A long random string you invent. The same value goes in the Sanity webhook
# "Secret" field. Generate one with:  openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# --- Site -----------------------------------------------------------------
# The public address of the site, without a trailing slash.
# Locally: http://localhost:3000   On Netlify: https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Only for `npm run seed` (fills the CMS with sample content) -----------
# A token with "Editor" permissions. Delete it from sanity.io/manage afterwards.
SANITY_API_WRITE_TOKEN=
