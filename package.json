{
  "name": "dynamic-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --path ./sanity/extract.json --enforce-required-fields --force && sanity typegen generate",
    "test": "vitest run",
    "seed": "tsx scripts/seed/index.ts",
    "dev:mock": "tsx scripts/dev/preview.ts",
    "preview:mock": "tsx scripts/dev/preview.ts --prod",
    "seed:login": "sanity exec scripts/seed/index.ts --with-user-token"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^7.28.0",
    "@sanity/icons": "^5.3.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/ui": "^4.4.10",
    "@sanity/vision": "^6.22.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-sanity": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.22.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/webhook": "^4.0.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "groq-js": "^2.0.1",
    "lexorank": "^1.0.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
